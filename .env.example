# Copy to .env.local. See README §2 "Local startup".

# mock = seeded demo store, simulated USC sign-in, no credentials needed.
# live = Supabase + Google Maps (persistence not wired yet; see docs/integration-log.md).
APP_MODE=mock

# Seats per trip, including the Booker. Mock demo fixture uses 4.
# Live mode refuses to start without the team-approved value (docs/decisions.md D-001).
TRIP_CAPACITY=4

# Active billing-agreement version; signups must send this exact value.
AGREEMENT_VERSION=mock-terms-v1

# Riders cannot leave within this many minutes of departure (docs/decisions.md D-003).
LEAVE_CUTOFF_MINUTES=60

# Pending no-show report demo (on|off). Reports never issue strikes.
ATTENDANCE_REPORTING=on

# Most extra minutes the group route may add to any rider's trip (docs/decisions.md D-010).
ROUTE_MAX_DETOUR_MINUTES=10

# Estimated Uber price per road mile and fee per extra stop, used to split the fare (docs/decisions.md D-011).
# Demo defaults: replace with the real rates.
UBER_PRICE_PER_MILE=2.50
UBER_STOP_FEE=1.00

# Serverless hosting (Vercel): keep the demo data in Redis so every server sees the same trips.
# Vercel's Redis integration sets KV_REST_API_URL and KV_REST_API_TOKEN for you (a direct Upstash
# database uses UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN). Leave blank to use process memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Hours before shared demo data is reseeded (seeded trips are dated from the seed moment).
DEMO_DATA_TTL_HOURS=6

# Live mode only. Server-only key: never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
# Optional. Shows the route on a real Google map. This is a SEPARATE browser key (it is visible to visitors):
# enable only Maps JavaScript API and restrict it to your site's HTTP referrers. Blank = simple route diagram.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
