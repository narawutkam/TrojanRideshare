# Copy to .env.local. See README §2 "Local startup".

# mock = seeded demo store, simulated USC sign-in, no credentials needed.
# live = Supabase + Google Maps (persistence not wired yet; see docs/integration-log.md).
APP_MODE=mock

# Seats per trip, including the Booker. Mock demo fixture uses 4.
# Live mode refuses to start without the team-approved value (docs/decisions.md D-001).
TRIP_CAPACITY=4

# Active billing-agreement version; signups must send this exact value.
AGREEMENT_VERSION=mock-terms-v1

# Riders cannot leave within this many minutes of departure (docs/decisions.md D-003).
LEAVE_CUTOFF_MINUTES=60

# Pending no-show report demo (on|off). Reports never issue strikes.
ATTENDANCE_REPORTING=on

# Live mode only. Server-only key: never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
